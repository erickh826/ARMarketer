generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ImageTargetCompileStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum ARContentType {
  MODEL_3D
  PANORAMA_360
  VIDEO_360
  IMAGE_TRACKING
}

enum MediaAssetKind {
  MODEL_3D
  PANORAMA_360
  VIDEO_360
  AUDIO
}

enum MediaAssetStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum StorageProvider {
  LOCAL
  S3
  R2
  CDN
}

model Project {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  description   String?
  apiKey        String?        @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  imageTargets  ImageTarget[]
  experiences   ARExperience[]
  mediaAssets   MediaAsset[]
}

model MediaAsset {
  id              String           @id @default(cuid())
  projectId       String
  name            String
  kind            MediaAssetKind
  originalFilename String
  mimeType        String?
  storageProvider StorageProvider  @default(S3)
  storageKey      String           @unique
  sourceAssetId   String?
  originalUrl     String
  processedUrl    String?
  sourceFormat    String?
  processedFormat String?
  fileSizeBytes   BigInt?
  checksumSha256  String?
  processingJobId String?
  status          MediaAssetStatus @default(UPLOADED)
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceAsset     MediaAsset?      @relation("DerivedAssets", fields: [sourceAssetId], references: [id], onDelete: SetNull)
  derivedAssets   MediaAsset[]     @relation("DerivedAssets")
  experiences     ARExperience[]

  @@index([projectId])
  @@index([kind])
  @@index([status])
  @@index([sourceAssetId])
}

model ImageTarget {
  id                 String                   @id @default(cuid())
  projectId          String
  name               String
  sourceImageUrl     String
  compiledMindUrl    String?
  compileStatus      ImageTargetCompileStatus @default(PENDING)
  physicalWidthCm    Decimal?                 @db.Decimal(6, 2)
  boundExperienceId  String?                  @unique
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  project            Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boundExperience    ARExperience?            @relation("BoundExperience", fields: [boundExperienceId], references: [id], onDelete: SetNull)
  experiences        ARExperience[]           @relation("TargetExperiences")

  @@index([projectId])
  @@index([compileStatus])
}

model ARExperience {
  id                String         @id @default(cuid())
  projectId         String
  name              String
  imageTargetId     String?
  mediaAssetId      String?
  contentType       ARContentType
  /// Legacy/freeform scene key for viewer-specific configuration.
  /// Do not use this field as the primary asset reference; prefer mediaAssetId.
  contentSceneId    String?
  transform         Json?
  animationConfig   Json?
  audioUrl          String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imageTarget       ImageTarget?   @relation("TargetExperiences", fields: [imageTargetId], references: [id], onDelete: SetNull)
  mediaAsset        MediaAsset?    @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  boundByTarget     ImageTarget?   @relation("BoundExperience")

  @@index([projectId])
  @@index([imageTargetId])
  @@index([mediaAssetId])
  @@index([contentType])
}
