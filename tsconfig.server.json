{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "outDir": "dist/server",
    "rootDir": ".",
    "noEmit": true,
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "types": [
      "node"
    ],
    "paths": {
      "@server/*": [
        "server/*"
      ]
    }
  },
  "include": [
    "prisma/**/*.ts",
    "src/lib/server/**/*.ts",
    "src/app/api/**/*.ts",
    "server/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
